<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>0.2.0-preview.3</Version>
    <Authors>TBankAcquiringNet contributors</Authors>
    <PackageProjectUrl>https://github.com/ai-iskuzhin/TBankAcquiringNet.SplitShops</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ai-iskuzhin/TBankAcquiringNet.SplitShops</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tbank;tinkoff;acquiring;split;shops</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
